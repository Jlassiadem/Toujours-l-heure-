{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>User</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_user</th>
                <td>{{ user.id_User }}</td>
            </tr>
            <tr>
                <th>Fullname</th>
                <td>{{ user.Fullname }}</td>
            </tr>
            <tr>
                <th>Tele</th>
                <td>{{ user.tele }}</td>
            </tr>
            <tr>
                <th>Mail</th>
                <td>{{ user.mail }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ user.role }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_index') }}">back to list</a>

    <a href="{{ path('app_user_edit', {'id_user': user.id_user}) }}">edit</a>

    {{ include('client/user/_delete_form.html.twig') }}
{% endblock %}

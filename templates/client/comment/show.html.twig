{% extends 'base.html.twig' %}

{% block title %}Comment{% endblock %}

{% block body %}
    <h1>Comment</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_comment</th>
                <td>{{ comment.id_Comment }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ comment.content }}</td>
            </tr>
            <tr>
                <th>Date_posted</th>
                <td>{{ comment.datePosted ? comment.datePosted|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Is_reported</th>
                <td>{{ comment.isReported ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Report_reason</th>
                <td>{{ comment.reportReason }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_comment_index') }}">back to list</a>

    <a href="{{ path('app_comment_edit', {'id_comment': comment.id_comment}) }}">edit</a>

    {{ include('comment/_delete_form.html.twig') }}
{% endblock %}

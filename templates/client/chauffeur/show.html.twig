{% extends 'base.html.twig' %}

{% block title %}Chauffeur{% endblock %}

{% block body %}
    <h1>Chauffeur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Name</th>
                <td>{{ chauffeur.name }}</td>
            </tr>
            <tr>
                <th>Contact_number</th>
                <td>{{ chauffeur.contact_number }}</td>
            </tr>
            <tr>
                <th>Is_available</th>
                <td>{{ chauffeur.is_available ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>License_number</th>
                <td>{{ chauffeur.license_number }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_chauffeur_index') }}">back to list</a>

    <a href="{{ path('app_chauffeur_edit', {'chauffeur_id': chauffeur.chauffeur_id}) }}">edit</a>

    {{ include('client/chauffeur/_delete_form.html.twig') }}
{% endblock %}
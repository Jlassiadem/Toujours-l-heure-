{% extends 'base.html.twig' %}

{% block title %}Chauffeur{% endblock %}

{% block body %}
    <h1>Chauffeur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Chauffeur_id</th>
                <td>{{ chauffeur.chauffeur_id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ chauffeur.name }}</td>
            </tr>
            <tr>
                <th>Contact_number</th>
                <td>{{ chauffeur.contact_number }}</td>
            </tr>
            <tr>
                <th>Is_available</th>
                <td>{{ chauffeur.is_available ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Owned_by_admin</th>
                <td>{{ chauffeur.owned_by_admin }}</td>
            </tr>
            <tr>
                <th>Added_date</th>
                <td>{{ chauffeur.added_date ? chauffeur.added_date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>License_number</th>
                <td>{{ chauffeur.license_number }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_chauffeur_indexad') }}">back to list</a>

    <a href="{{ path('app_chauffeur_editad', {'chauffeur_id': chauffeur.chauffeur_id}) }}">edit</a>

    {{ include('admin/chauffeur/_delete_form.html.twig') }}
{% endblock %}
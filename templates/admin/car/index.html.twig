{% extends 'base.html.twig' %}

{% block title %}Car Management{% endblock %}

{% block stylesheets %}
    <!-- Material Dashboard CSS -->
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,900" />
    <link href="{{ asset('assetad/css/nucleo-icons.css') }}" rel="stylesheet" />
    <link href="{{ asset('assetad/css/nucleo-svg.css') }}" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link id="pagestyle" href="{{ asset('assetad/css/material-dashboard.css?v=3.2.0') }}" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #00B98E;
            --primary-hover: #00a57d;
            --primary-light: rgba(0, 185, 142, 0.1);
            --gradient-primary: linear-gradient(195deg, #00B98E 0%, #008a6a 100%);
        }
        
        .bg-gradient-primary {
            background: var(--gradient-primary) !important;
        }
        
        .btn-primary, .bg-primary {
            background-color: var(--primary-color) !important;
            border-color: var(--primary-color) !important;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-hover) !important;
            border-color: var(--primary-hover) !important;
        }
        
        .text-primary {
            color: var(--primary-color) !important;
        }
        
        .border-primary {
            border-color: var(--primary-color) !important;
        }
        
        .btn-outline-primary {
            border-color: var(--primary-color) !important;
            color: var(--primary-color) !important;
        }
        
        .car-icon-link {
            display: inline-block;
            transition: transform 0.2s ease;
        }

        .car-icon-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .car-icon-link:hover {
            transform: translateY(-3px);
        }

        .car-icon-link:hover .car-icon-img {
            border-color: #4a6bff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }
        
        .btn-outline-primary:hover {
            background-color: var(--primary-color) !important;
            color: #fff !important;
        }
    </style>
{% endblock %}


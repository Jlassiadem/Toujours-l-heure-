{% block javascripts %}
    <!-- Material Dashboard JS -->
    <script src="{{ asset('assetad/js/core/popper.min.js') }}"></script>
    <script src="{{ asset('assetad/js/core/bootstrap.min.js') }}"></script>
    <script src="{{ asset('assetad/js/plugins/perfect-scrollbar.min.js') }}"></script>
    <script src="{{ asset('assetad/js/plugins/smooth-scrollbar.min.js') }}"></script>
    <!-- Add Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        var win = navigator.platform.indexOf('Win') > -1;
        if (win && document.querySelector('#sidenav-scrollbar')) {
            var options = {
                damping: '0.5'
            };
            Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
        }
        
        // Global variables to store chart instances
        window.brandChart = null;
        window.modelChart = null;
        
        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Search functionality
            const searchInput = document.querySelector('input[type="text"]');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const rows = document.querySelectorAll('tbody tr');
                    
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(searchTerm) ? '' : 'none';
                    });
                });
            }
            
            // Add event listeners to delete forms
            setupDeleteForms();
            
            // Chart initialization
            initializeCharts();
        });
        
        // Setup event listeners for delete forms
        function setupDeleteForms() {
            document.querySelectorAll('form[action*="app_car_delete"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    // The default confirmation is already in the form's onsubmit
                    // We just need to ensure the page reloads after submission
                    // The form will submit normally, and the page will refresh
                });
            });
        }
        
        // Initialize or reinitialize charts
        function initializeCharts() {
            // Clear existing charts if they exist
            if (window.brandChart) window.brandChart.destroy();
            if (window.modelChart) window.modelChart.destroy();
            
            // Get car data from Twig template directly
            const carData = [
                {% for car in cars %}
                {
                    brand: "{{ car.mark }}",
                    model: "{{ car.model }}"
                },
                {% endfor %}
            ];
            
            if (carData.length > 0) {
                createBrandChart(carData);
                createModelChart(carData);
            } else {
                console.log("No car data available for charts");
                displayEmptyChartMessage();
            }
        }
        
        // Display a message when no data is available
        function displayEmptyChartMessage() {
            const brandCtx = document.getElementById('chart-brand-bar');
            const modelCtx = document.getElementById('chart-model-pie');
            
            if (brandCtx) {
                const brandCanvas = brandCtx.getContext('2d');
                brandCanvas.clearRect(0, 0, brandCtx.width || brandCtx.clientWidth, brandCtx.height || brandCtx.clientHeight);
                brandCanvas.font = '14px Arial';
                brandCanvas.fillStyle = '#666';
                brandCanvas.textAlign = 'center';
                brandCanvas.fillText('No car data available', 
                    (brandCtx.width || brandCtx.clientWidth) / 2, 
                    (brandCtx.height || brandCtx.clientHeight) / 2);
            }
            
            if (modelCtx) {
                const modelCanvas = modelCtx.getContext('2d');
                modelCanvas.clearRect(0, 0, modelCtx.width || modelCtx.clientWidth, modelCtx.height || modelCtx.clientHeight);
                modelCanvas.font = '14px Arial';
                modelCanvas.fillStyle = '#666';
                modelCanvas.textAlign = 'center';
                modelCanvas.fillText('No car data available', 
                    (modelCtx.width || modelCtx.clientWidth) / 2, 
                    (modelCtx.height || modelCtx.clientHeight) / 2);
            }
        }
        
        // Create Bar Chart for Car Brands
        function createBrandChart(cars) {
            // Count cars by brand
            const brandCounts = {};
            cars.forEach(car => {
                if (!brandCounts[car.brand]) {
                    brandCounts[car.brand] = 0;
                }
                brandCounts[car.brand]++;
            });
            
            const brandLabels = Object.keys(brandCounts);
            const brandData = Object.values(brandCounts);
            
            const ctx = document.getElementById('chart-brand-bar');
            if (ctx) {
                window.brandChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: brandLabels,
                        datasets: [{
                            label: 'Number of Cars',
                            data: brandData,
                            backgroundColor: [
                                'rgba(0, 185, 142, 0.8)',  // Primary green
                                'rgba(233, 30, 99, 0.8)',  // Red
                                'rgba(255, 152, 0, 0.8)',  // Orange
                                'rgba(86, 11, 173, 0.8)',  // Purple
                                'rgba(76, 175, 80, 0.8)',  // Light green
                                'rgba(96, 125, 139, 0.8)'  // Blue gray
                            ],
                            borderColor: [
                                'rgb(0, 165, 125)',
                                'rgb(213, 10, 79)',
                                'rgb(235, 132, 0)',
                                'rgb(66, 0, 153)',
                                'rgb(56, 155, 60)',
                                'rgb(76, 105, 119)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(0,0,0,0.1)'
                                },
                                ticks: {
                                    precision: 0
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            } else {
                console.error("Could not find chart-brand-bar canvas element");
            }
        }
        
        // Create Pie Chart for Car Models
        function createModelChart(cars) {
            // Count cars by model
            const modelCounts = {};
            cars.forEach(car => {
                if (!modelCounts[car.model]) {
                    modelCounts[car.model] = 0;
                }
                modelCounts[car.model]++;
            });
            
            const modelLabels = Object.keys(modelCounts);
            const modelData = Object.values(modelCounts);
            
            // Generate colors for each model
            const backgroundColors = modelLabels.map((_, index) => {
                const hue = (index * 50) % 360;
                return `hsla(${hue}, 70%, 60%, 0.8)`;
            });
            
            const borderColors = backgroundColors.map(color => {
                return color.replace('0.8', '1');
            });
            
            const ctx = document.getElementById('chart-model-pie');
            if (ctx) {
                window.modelChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: modelLabels,
                        datasets: [{
                            data: modelData,
                            backgroundColor: backgroundColors,
                            borderColor: borderColors,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        },
                        cutout: '60%'
                    }
                });
            } else {
                console.error("Could not find chart-model-pie canvas element");
            }
        }
        
        // Function to update statistics in the UI (can be extended if needed)
        function updateStatistics(stats) {
            if (stats) {
                // Update total cars count
                const totalCarsElement = document.querySelector('.card-body p:contains("Total Cars")').nextElementSibling;
                if (totalCarsElement) {
                    totalCarsElement.textContent = stats.totalCars;
                }
                
                // Update available cars count
                const availableCarsElement = document.querySelector('.card-body p:contains("Available Cars")').nextElementSibling;
                if (availableCarsElement) {
                    availableCarsElement.textContent = stats.availableCars;
                }
                
                // Update unique brands count
                const uniqueBrandsElement = document.querySelector('.card-body p:contains("Unique Brands")').nextElementSibling;
                if (uniqueBrandsElement) {
                    uniqueBrandsElement.textContent = stats.uniqueBrands;
                }
            }
        }
    </script>
{% endblock %}
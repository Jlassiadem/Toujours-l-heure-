//delete_form.html.twig 
<form method="post" action="{{ path('app_user_delete', {'id_user': user.id_user}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id_user) }}">
    <button class="btn">Delete</button>
</form>
//_form.html.twig
{{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
